<!DOCTYPE html>
<html lang="en">
<head>
    <!-- WCAG 2.4.2: Added a descriptive title for the page. -->
    <title>Sandbox Environment Notice</title>

    <!-- Standard meta tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Fonts: Inter is the PDS v2 default typeface (--pds-typography-ff-default) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&display=swap" rel="stylesheet" />

    <script>
        function cont() {
            document.cookie = "Deterrence-Bypass=1; domain=dev-bioo-siite.pantheonsite.io; path=/; max-age=86400;";
            window.location.reload();
        }
    </script>

    <style>
        /* Light theme, the default. These are the PDS light token values. */
        :root {
            /* --pds-color-surface-default-secondary */
            --page-background: #f6f6f6;
            /* --pds-color-foreground-default */
            --page-foreground: #1a1a1a;
            /* --pds-color-foreground-default-secondary */
            --page-foreground-secondary: #5c5d5e;
            /* --pds-color-button-primary-background-default */
            --button-background: #1a1a1a;
            /* --pds-color-button-primary-background-hover */
            --button-background-hover: #303030;
            /* --pds-color-button-primary-background-active */
            --button-background-active: #404040;
            /* --pds-color-button-primary-foreground */
            --button-foreground: #ffffff;
            /* --pds-color-interactive-focus */
            --interactive-focus: #207dde;

            /*
             * Tells the browser to render form controls, scrollbars and the canvas
             * in the matching theme, so nothing UA-painted stays stuck in light.
             */
            color-scheme: light dark;
        }

        /*
         * Dark theme, driven entirely by the visitor's OS/browser preference. That is
         * the only theme signal available here: the interstitial is served on the
         * customer's own sandbox domain, so it has no access to a Pantheon dashboard
         * theme preference. These are the PDS dark token values.
         */
        @media (prefers-color-scheme: dark) {
            :root {
                --page-background: #222222;
                --page-foreground: #f5f5f5;
                --page-foreground-secondary: #cccccc;
                --button-background: #f5f5f5;
                --button-background-hover: #d7d7d7;
                --button-background-active: #c1c1c1;
                --button-foreground: #1a1a1a;
                --interactive-focus: #479af8;
            }
        }

        body {
            /* WCAG 1.4.3, 1.4.4: Using relative units and ensuring high contrast */
            color: var(--page-foreground);
            background-color: var(--page-background);
            font-family: 'Inter', sans-serif;
            /* --pds-typography-fw-regular */
            font-weight: 400;
            /* --pds-typography-lh-m */
            line-height: 150%;
            margin: 0;
            /* --pds-spacing-l */
            padding: 1.25rem;
            min-height: 100vh;
            box-sizing: border-box;

            /* Center the main content */
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        /* WCAG 2.4.1: Added a skip link for keyboard users */
        .skip-link {
            border: 0;
            clip: rect(1px, 1px, 1px, 1px);
            clip-path: inset(50%);
            height: 1px;
            margin: -1px;
            overflow: hidden;
            padding: 0;
            position: absolute;
            width: 1px;
            white-space: nowrap;
        }

        .skip-link:focus {
            clip: auto;
            clip-path: none;
            width: auto;
            height: auto;
            position: absolute;
            top: 1rem;
            left: 1rem;
            background-color: var(--button-background);
            color: var(--button-foreground);
            padding: 0.5rem 1rem;
            z-index: 100;
            text-decoration: none;
            /* --pds-border-radius-default */
            border-radius: 0.188rem;
        }


        /* WCAG 1.3.1, 4.1.2: Using semantic <main> tag for the primary content */
        main {
            max-width: 45rem;
            width: 100%;
        }

        h1 {
            /*
             * WCAG 1.4.4: --pds-typography-size-4xl already scales fluidly between
             * the small and large breakpoints, so no separate mobile override is needed.
             */
            font-size: clamp(1.6rem, 1.42rem + 0.73vw, 2rem);
            /* --pds-typography-fw-semibold */
            font-weight: 600;
            /* --pds-typography-lh-xs */
            line-height: 120%;
            margin: 0;
        }

        p {
            /* --pds-typography-size-m */
            font-size: 1rem;
            /* --pds-spacing-l */
            margin: 1.25rem 0 0;
        }

        /* The supporting line sits tight under the heading, in the secondary foreground */
        p:first-of-type {
            color: var(--page-foreground-secondary);
            /* --pds-spacing-s */
            margin-top: 0.75rem;
        }

        strong {
            /* --pds-typography-fw-semibold */
            font-weight: 600;
        }

        .pds-button {
            background-color: var(--button-background);
            border: 1px solid var(--button-background);
            color: var(--button-foreground);
            /* --pds-border-radius-button */
            border-radius: 3.5rem;
            box-sizing: border-box;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            /* --pds-typography-size-m, matching the PDS medium button */
            font-size: 1rem;
            /* --pds-typography-fw-medium */
            font-weight: 500;
            line-height: 1;
            /* --pds-spacing-button-height-m */
            height: 2.5rem;
            /* --pds-spacing-button-padding-inline-m */
            padding: 0 1.25rem;
            text-decoration: none;
            /* Approximates --pds-animation-transition-button */
            transition: background-color 200ms cubic-bezier(.2, 0, 0, 1), border-color 200ms cubic-bezier(.2, 0, 0, 1), color 200ms cubic-bezier(.2, 0, 0, 1);
            white-space: nowrap;
            /* --pds-spacing-2xl */
            margin-top: 2rem;

            /* Center the label, matching the PDS button's inline-flex layout */
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .pds-button:hover {
            background-color: var(--button-background-hover);
            border-color: var(--button-background-hover);
        }

        .pds-button:active {
            background-color: var(--button-background-active);
            border-color: var(--button-background-active);
        }

        /*
         * WCAG 1.4.11, 2.1.1: Clear focus state for keyboard users. Uses :focus-visible
         * so the ring appears for keyboard navigation without firing on mouse click.
         */
        .pds-button:focus-visible {
            /* --pds-border-width-outline */
            outline: 2px solid var(--interactive-focus);
            outline-offset: 1px;
        }

        /* Respect a reduced-motion preference */
        @media (prefers-reduced-motion: reduce) {
            .pds-button {
                transition: none;
            }
        }
    </style>
</head>
<body>
    <!-- WCAG 2.4.1: This link is the first focusable item for keyboard users. -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- WCAG 1.3.1: Proper semantic structure with a <main> element -->
    <main id="main-content">
        <h1>This website is hosted in a sandbox environment.</h1>
        <p>Sandboxes are typically used for development and testing purposes.</p>
        <p><strong>Be cautious before entering any personal or financial information.</strong></p>

        <!-- WCAG 4.1.2: The button has an accessible name from its content. -->
        <button class="pds-button" onclick='cont()'>Continue</button>
    </main>

</body>
</html>